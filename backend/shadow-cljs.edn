;; deps.edn's :cljs alias is the classpath for every build below: source roots
;; (src/cljs, test/cljs, ../shared), JVM dependencies, and katamorph pinned by
;; Git ref. :source-paths and :dependencies are intentionally absent — in :deps
;; mode shadow-cljs ignores both and defers to tools.deps.
{:deps {:aliases [:cljs]},
 :nrepl {:port 4500},
 :js-options {:js-provider :import},
 :builds
 {:app
  {:target :esm,
   :output-dir "dist",
   :modules
   {:app
    {:exports
     {:createSessionHook
      knoxx.backend.auth.session/create-session-hook,
      :listEtaMuSessions
      knoxx.backend.eta-mu-session-ingester/list-eta-mu-sessions,
      :registerAuthRoutes
      knoxx.backend.routes.auth/register-auth-routes,
      :config knoxx.backend.core/config-js,
      :bootstrap knoxx.backend.bootstrap/bootstrap!,
      :createDiscordGatewayManager
      knoxx.backend.discord-gateway/createDiscordGatewayManager,
      :createPolicyDb knoxx.backend.policy-db/create-policy-db,
      :start knoxx.backend.core/start!,
      :getEtaMuIngestStatus
      knoxx.backend.eta-mu-session-ingester/get-eta-mu-ingest-status,
      :registerAppRoutes knoxx.backend.core/register-app-routes!,
      :createKnoxxCustomTools
      knoxx.backend.mcp-expose/create-knoxx-custom-tools-js,
      :registerWsRoutes knoxx.backend.core/register-ws-routes!,
      :resolveAuthContext
      knoxx.backend.auth.session/resolve-auth-context}}},
   :js-options
   {:js-provider :import,
    :keep-as-import
    #{"node:child_process"
      "node:fs/promises"
      "node:crypto"
      "@open-hax/eta-mu-cli"
      "node:fs"
      "node:path"
      "node:url"
      "discord.js"
      "@discordjs/voice"
      "libsodium-wrappers"
      "puppeteer-core"}},
   :compiler-options
   {:output-feature-set :es-next,
    :optimizations :simple,
    :source-map true,
    :infer-externs false,
    :macros {:knoxx.backend.macros true},
    :warnings {:infer-warning false}}},
  :server-dev
  {:target :esm,
   :runtime :node,
   :output-dir "dist-dev",
   :modules {:server {:init-fn knoxx.backend.entrypoint/init}},
   :js-options
   {:js-provider :import,
    :keep-as-import
    #{"puppeteer-core"
      "@modelcontextprotocol/sdk"
      "node:child_process"
      "node:fs/promises"
      "node:crypto"
      "node:fs"
      "node:path"
      "node:url"
      "@open-hax/eta-mu-cli"
      "discord.js"
      "@discordjs/voice"
      "libsodium-wrappers"}},
   :devtools
   {:autoload true,
    :preloads [shadow.cljs.devtools.client.node-esm],
    ;; This codebase has existing infer warnings; without ignore-warnings,
    ;; shadow compiles but refuses to hot-load changed code.
    :ignore-warnings true,
    :before-load-async knoxx.backend.bootstrap/stop-http-before-load!,
    :after-load-async knoxx.backend.bootstrap/start-http-after-load!},
   :compiler-options
   {:output-feature-set :es-next,
    :optimizations :none,
    :source-map true,
    :infer-externs false,
    :macros {:knoxx.backend.macros true},
    :warnings {:infer-warning false}}},
  :server
  {:target :esm,
   :runtime :node,
   :output-dir "dist",
   :modules {:server {:init-fn knoxx.backend.entrypoint/init}},
   :js-options
   {:js-provider :import,
    :keep-as-import
    #{"puppeteer-core"
      "@modelcontextprotocol/sdk"
      "node:child_process"
      "node:fs/promises"
      "node:crypto"
      "node:fs"
      "node:path"
      "node:url"
      "@open-hax/eta-mu-cli"
      "discord.js"
      "@discordjs/voice"
      "libsodium-wrappers"}},
   :compiler-options
   {:output-feature-set :es-next,
    :optimizations :none,
    :source-map true,
    :infer-externs false,
    :macros {:knoxx.backend.macros true},
    :warnings {:infer-warning false}}},
  :test
  {:target :node-test,
   :output-to "target/test/test.cjs",
   :ns-regex ["knoxx.backend.*-test$"],
   :autorun true,
   :js-options {:resolve {"@open-hax/eta-mu-cli" {:target :file
                                                     :file "test/js/eta_mu_cli_test_stub.cjs"}
                          "@open-hax/openplanner-sdk" {:target :file
                                                       :file "test/js/openplanner_sdk_test_stub.mjs"}
                          "@open-hax/openplanner-sdk/mongo-vectors" {:target :file
                                                                     :file "test/js/openplanner_sdk_test_stub.mjs"}}},
   :compiler-options
   {:output-feature-set :es-next,
    :macros {:knoxx.backend.macros true},
    :infer-externs false}},
  ;; End-to-end suite. Boots a real Fastify app on an ephemeral port and drives
  ;; it over HTTP. Namespaces end in -e2e rather than -test so the unit builds,
  ;; whose ns-regex is "-test$", cannot pick them up: a suite that opens sockets
  ;; must be something you choose to run, and the file suffix should say so.
  :e2e
  {:target :node-test,
   :output-to "target/e2e/e2e.cjs",
   ;; :ns-regexp, singular and a string. shadow ignores an unknown :ns-regex
   ;; key silently and falls back to its "-test$" default, which is why the
   ;; unit builds in this file run every test namespace regardless of the
   ;; pattern they name.
   :ns-regexp "knoxx\\.backend\\.e2e\\..*-e2e$",
   :autorun true,
   :js-options {:resolve {"@open-hax/eta-mu-cli" {:target :file
                                                  :file "test/js/eta_mu_cli_test_stub.cjs"}
                          "@open-hax/openplanner-sdk" {:target :file
                                                       :file "test/js/openplanner_sdk_test_stub.mjs"}
                          "@open-hax/openplanner-sdk/mongo-vectors" {:target :file
                                                                     :file "test/js/openplanner_sdk_test_stub.mjs"}}},
   :compiler-options
   {:output-feature-set :es-next,
    :optimizations :none,
    :source-map true,
    :infer-externs false,
    :macros {:knoxx.backend.macros true}}},

  :test-ci
  {:target :node-test,
   :output-to "target/test/test-ci.cjs",
   :ns-regex ["knoxx.backend.*-test$"],
   :autorun false,
   :js-options {:resolve {"@open-hax/eta-mu-cli" {:target :file
                                                     :file "test/js/eta_mu_cli_test_stub.cjs"}
                          "@open-hax/openplanner-sdk" {:target :file
                                                       :file "test/js/openplanner_sdk_test_stub.mjs"}
                          "@open-hax/openplanner-sdk/mongo-vectors" {:target :file
                                                                     :file "test/js/openplanner_sdk_test_stub.mjs"}}},
    :compiler-options
    {:output-feature-set :es-next,
     :optimizations :none,
     :source-map true,
     :infer-externs false,
     :macros {:knoxx.backend.macros true}}}}}
