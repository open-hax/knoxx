{
  "name": "@open-hax/knoxx-backend-cljs",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "shadow-cljs release server",
    "watch": "shadow-cljs watch server-dev",
    "start": "node dist/server.js",
    "start:dev": "nbb scripts/start-server-dev.cljs",
    "start:dev:direct": "node dist-dev/server.js",
    "test": "node --test test/js/*.test.mjs && node scripts/run-shadow-tests-ci.mjs",
    "test:coverage": "node --test test/js/*.test.mjs && node scripts/run-shadow-tests-coverage-ci.mjs",
    "test:smoke": "node --test test/js/*.test.mjs",
    "test:mutation": "clojure -M:mutation --run --limit 100",
    "mutation:smoke": "clojure -M:mutation --run --limit 10",
    "mutation:dry-run": "clojure -M:mutation --dry-run --limit 250",
    "mutation:campaign": "clojure -M:mutation --run --limit 0",
    "mutation:harness-test": "clojure -M:mutation-test",
    "test:shadow": "shadow-cljs compile test",
    "test:e2e": "node scripts/run-shadow-tests-ci.mjs e2e",
    "lint": "clj-kondo --lint src/cljs test/cljs",
    "lint:shared-markup": "clj-kondo --lint ../shared/src/cljs src/cljs/knoxx/backend/law/svg.cljs src/cljs/knoxx/backend/infra/routes/mcp/consent.cljs src/cljs/knoxx/backend/infra/svg_render.cljs test/cljs/knoxx/backend/law/svg_test.cljs test/cljs/knoxx/backend/uxx_html_renderer_test.cljs test/cljs/knoxx/backend/mcp_consent_rendering_test.cljs test/cljs/knoxx/backend/svg_render_test.cljs --fail-level error",
    "boundary:check": "node scripts/check-js-boundary.mjs --check",
    "boundary:inventory": "node scripts/check-js-boundary.mjs --markdown",
    "error-boundaries:check": "node scripts/check-error-boundaries.mjs --check",
    "error-boundaries:inventory": "node scripts/check-error-boundaries.mjs --markdown",
    "typecheck": "shadow-cljs compile server",
    "lint:size": "node ../scripts/lint-file-sizes.mjs backend/src/cljs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@open-hax/eta-mu-cli": "^0.70.14",
    "@open-hax/openplanner-sdk": "link:../../openplanner/packages/openplanner-sdk",
    "@sinclair/typebox": "^0.34.41",
    "audiobuffer-to-wav": "^1.0.0",
    "c8": "^10.1.3",
    "discord.js": "^14.26.3",
    "events": "^3.3.0",
    "fastify": "^5.6.1",
    "libsodium-wrappers": "^0.7.15",
    "mongodb": "^6.18.0",
    "nbb": "^1.4.207",
    "node-web-audio-api": "^1.0.9",
    "nodemailer": "^6.9.16",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "punycode": "^2.3.1",
    "puppeteer-core": "^24.43.0",
    "qs": "^6.15.0",
    "shadow-cljs": "^3.4.10",
    "url": "^0.11.4",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  }
}
