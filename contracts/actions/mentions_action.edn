{:contract/kind  :action
 :contract/id    "mentions_action"
 :enabled        false

 :action/id      :actions/mentions
 :action/kind    :actions/run-steps
 :action/handler "knoxx.backend.domain.action.registry/run-action!"

 :action/with
 {:steps
  [{:action :actions/start-agent-session
    :with   {:agent-id "discord_mention_check"
             :output   {:key "mention_queue" :ttl "PT30M"}}}]
  :output {:key "mentions_result" :ttl "PT1H"}}

 :action/scope
 {:actions [:actions/start-agent-session]}

 :data
 {:context {:source "discord-mentions"}}}
