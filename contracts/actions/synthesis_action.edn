{:contract/kind  :action
 :contract/id    "synthesis_action"
 :enabled        false

 :action/id      :actions/synthesis
 :action/kind    :actions/run-steps
 :action/handler "knoxx.backend.domain.action.registry/run-action!"

 :action/with
 {:steps
  [{:action :actions/start-agent-session
    :with   {:agent-id "fetch_discord_digest"
             :context  {:channelId "1234567890"}
             :output   {:key "discord_digest" :ttl "PT2H"}}}]
  :output {:key "synthesis_result" :ttl "PT6H"}}

 :action/scope
 {:actions [:actions/start-agent-session]}

 :data
 {:context {:source "scheduled-synthesis"}}}
