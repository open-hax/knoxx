{:namespace :patrol
 :resources
 [{:trigger/id :patrol-event
   :trigger/kind :event
   :trigger/listener "discord_automation"
   :trigger/events [:schedule/patrol]
   :trigger/action :actions/patrol
   :trigger/context {:channelId "{{defaultChannels}}"
                     :patrol true}
   :enabled false}

  {:action/id :patrol
   :action/kind :actions/run-steps
   :action/handler "knoxx.backend.domain.action.registry/run-action!"
   :action/with {:steps [{:action :actions/start-agent-session
                          :with {:agent-id "discord_patrol"
                                 :context {:channelId "{{trigger.context.channelId}}"}
                                 :output {:key "patrol_result" :ttl "PT1H"}}}]
                 :output {:key "patrol_pipeline_result" :ttl "PT2H"}}
   :action/scope {:actions [:actions/start-agent-session]}
   :action/context {:source "discord-patrol"}
   :enabled false}]}
