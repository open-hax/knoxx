{:namespace :synthesis
 :resources
 [{:schedule/id :daily
   :schedule/rule "0 9 * * *"
   :schedule/generator "knoxx_schedule"
   :schedule/event {:event/type :schedule/daily-synthesis
                    :event/payload {:reason "schedule event: daily synthesis"}}
   :enabled false}

  {:schedule/id :deep
   :schedule/rule "0 3 * * 0"
   :schedule/generator "knoxx_schedule"
   :schedule/event {:event/type :schedule/deep-synthesis
                    :event/payload {:reason "schedule event: deep synthesis"}}
   :enabled false}

  {:trigger/id :daily
   :trigger/kind :event
   :trigger/listener "system_admin"
   :trigger/events [:schedule/daily-synthesis]
   :trigger/action :actions/synthesis
   :trigger/context {:timezone "America/Chicago"
                     :report-window-hours 24}
   :enabled false}

  {:trigger/id :deep
   :trigger/kind :event
   :trigger/listener "system_admin"
   :trigger/events [:schedule/deep-synthesis]
   :trigger/action :actions/deep-synthesis
   :trigger/context {:timezone "America/Chicago"
                     :report-window-hours 24}
   :enabled false}

  {:action/id :synthesis
   :action/kind :actions/run-steps
   :action/handler "knoxx.backend.domain.action.registry/run-action!"
   :action/with {:steps [{:action :actions/start-agent-session
                          :with {:agent-id "fetch_discord_digest"
                                 :context {:channelId "1234567890"}
                                 :output {:key "discord_digest" :ttl "PT2H"}}}]
                 :output {:key "synthesis_result" :ttl "PT6H"}}
   :action/scope {:actions [:actions/start-agent-session]}
   :action/context {:source "scheduled-synthesis"}
   :enabled false}

  {:action/id :deep-synthesis
   :action/kind :actions/run-steps
   :action/handler "knoxx.backend.domain.action.registry/run-action!"
   :action/with {:steps [{:action :actions/start-agent-session
                          :with {:agent-id "discord_deep_synthesis"
                                 :output {:key "synthesis_data" :ttl "PT6H"}}}]
                 :output {:key "deep_synthesis_result" :ttl "PT6H"}}
   :action/scope {:actions [:actions/start-agent-session]}
   :action/context {:source "discord-deep-synthesis"}
   :enabled false}]}
