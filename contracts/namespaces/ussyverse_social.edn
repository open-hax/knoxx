{:namespace :ussyverse-social,
 :resources
 [{:schedule/id :creative,
   :schedule/rule "*/30 * * * *",
   :schedule/generator "knoxx_schedule",
   :schedule/event
   #:event{:type :schedule/ussyverse-social-creative,
           :payload
           {:reason "schedule event: ussyverse social creative",
            :channelId "KNOXX_SOCIAL_BINDING_DISCORD_ID_5",
            :content "Scheduled creative exploration, not a human request. Home Discord channel is KNOXX_SOCIAL_BINDING_DISCORD_ID_5. Find a fresh outside author or work before choosing an experiment."}},
   :enabled false}
  {:trigger/id :creative-cron,
   :trigger/kind :event,
   :trigger/listener "discord_automation",
   :trigger/events [:schedule/ussyverse-social-creative],
   :trigger/action :actions/start-agent-session,
   :trigger/with
   {:agent-id "ussyverse_social_creative",
    :task
    "Take a creative working turn as OpenHax. This is a schedule, not a human request. Home Discord channel is KNOXX_SOCIAL_BINDING_DISCORD_ID_5. Read a fresh Bluesky feed/search, choose an outside author (not KNOXX_SOCIAL_BINDING_BLUESKY_HANDLE_2 or KNOXX_SOCIAL_BINDING_BLUESKY_DID_2), and inspect their actual thread and a worthwhile link or media item. Your own replies and repost captions are delivery history, not outside evidence. If the feed contains only your own work, search a different interest. Read home Discord before deciding whether to share. Make a small concrete experiment only when the inspected work suggests one; a new slogan, metric, or manifesto alone is not a finished artifact. Keep untested creative hypotheses private with tier provisional and evidence pointing to the actual outside source. Before sharing, search memory_search kind knoxx.tool_receipt for the exact source URL and compare it with recent Discord messages. At most one public Discord send, to KNOXX_SOCIAL_BINDING_DISCORD_ID_5. No placeholder channel IDs. Finish privately with the source, artifact if any, and actual success/error receipt. A failed send means not delivered; never congratulate yourself or report completion without its receipt. Abstain when no worthwhile new experiment or discovery emerges."},
   :trigger/context
   {:reason "schedule event: ussyverse social creative"},
   :enabled false}]}
