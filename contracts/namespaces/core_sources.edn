{:namespace :core-sources
 :resources
 [{:source/id :source/openplanner-memory
   :source/name "OpenPlanner conversational memory"
   :source/type :context
   :enabled true
   :source/provider :openplanner
   :source/hydration {:strategy :memory-search
                      :mode :triggered
                      :k 6}
   :source/render {:title "OpenPlanner memory"
                   :description "Prior Knoxx session memory and action history; verify exact claims with memory_search or memory_session."}
   :source/tools [:memory_search :memory_session]}

  {:source/id :source/eta-mu-sessions
   :source/type :event-generator
   :source/name "eta-mu sessions"
   :source/driver :driver/eta-mu-ingestion
   :source/actor "system_admin"
   :source/listens [:eta-mu.session.started
                    :eta-mu.session.model-changed
                    :eta-mu.session.compacted
                    :eta-mu.session.message
                    :eta-mu.session.tool-call]
   :source/protocol {:lifecycle :ingester
                     :dispatch :event-dispatch
                     :credentials-owner "system_admin"}
   :enabled true}

  {:source/id :source/agent-runtime
   :source/type :event-generator
   :source/name "Agent runtime"
   :source/driver :driver/agents
   :source/actor "system_admin"
   :source/listens [:agent.session.started
                    :agent.session.switched
                    :agent.turn.started
                    :agent.turn.completed
                    :agent.tool.started
                    :agent.tool.completed]
   :source/protocol {:lifecycle :in-process
                     :dispatch :event-dispatch
                     :credentials-owner "system_admin"}
   :enabled true}

  {:source/id :source/knoxx-runtime
   :source/type :event-generator
   :source/name "Knoxx runtime"
   :source/driver :driver/knoxx
   :source/actor "system_admin"
   :source/listens [:knoxx.runtime.started
                    :knoxx.runtime.stopping
                    :knoxx.resource.changed]
   :source/protocol {:lifecycle :in-process
                     :dispatch :event-dispatch
                     :credentials-owner "system_admin"}
   :enabled true}

  {:source/id :source/org-events
   :source/type :event-generator
   :source/name "Organization events"
   :source/driver :driver/org
   :source/actor "system_admin"
   :source/listens [:org.created
                    :org.updated
                    :org.member.added
                    :org.member.removed]
   :source/protocol {:lifecycle :in-process
                     :dispatch :event-dispatch
                     :credentials-owner "system_admin"}
   :enabled true}

  {:source/id :source/session-events
   :source/type :event-generator
   :source/name "Session events"
   :source/driver :driver/sessions
   :source/actor "system_admin"
   :source/listens [:session.created
                    :session.resumed
                    :session.closed]
   :source/protocol {:lifecycle :in-process
                     :dispatch :event-dispatch
                     :credentials-owner "system_admin"}
   :enabled true}

  {:source/id :source/translation-events
   :source/type :event-generator
   :source/name "Translation events"
   :source/driver :driver/translations
   :source/actor "translations_page"
   :source/listens [:translation.segment.created
                    :translation.segment.reviewed
                    :translation.batch.completed]
   :source/protocol {:lifecycle :in-process
                     :dispatch :event-dispatch
                     :credentials-owner "translations_page"}
   :enabled true}

  {:source/id :source/user-events
   :source/type :event-generator
   :source/name "User events"
   :source/driver :driver/user
   :source/actor "workspace_user"
   :source/listens [:user.created
                    :user.updated
                    :user.message.sent]
   :source/protocol {:lifecycle :in-process
                     :dispatch :event-dispatch
                     :credentials-owner "workspace_user"}
   :enabled true}]}
