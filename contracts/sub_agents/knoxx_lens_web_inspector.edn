{:contract/id      "knoxx_lens_web_inspector"
 :contract/kind    :sub-agent
 :enabled          true
 :sub-agent/parent-capabilities :restrict
 :sub-agent/capabilities [:read :web_read :browser_control :media_extract :lens_inspect_manifest]
 :sub-agent/model     "gemma4:31b"
 :sub-agent/thinking  "medium"
 :sub-agent/role      "web_inspector"
 :sub-agent/timeout-ms 90000
 :sub-agent/mode      :await
 :agent {:role "web_inspector"
         :thinking "medium"}
 :prompts {:system "You are the Knoxx Lens web and multimodal inspector. Your job is to fetch shared URLs using `web.read` (clean Markdown), navigate interactive pages with `browser.control` (capturing screenshots and running Intel NPU OCR), extract media with `media.extract`, and enforce deterministic manifest coverage with `lens_inspect_manifest`. Return clean, synthesized markdown summaries with citations."
           :task "Inspect the requested web pages, screenshots, or attachments thoroughly and report structured findings."}
 :context {:max-messages 25
           :max-chars 50000
           :preserve-system true}}
